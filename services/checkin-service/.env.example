# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/checkin-service-trekVN

# ─── JWT (dùng để verify token từ auth-service) ───────────────────────────────
# PHẢI khớp với JWT_SECRET của auth-service
JWT_SECRET=change-me-to-a-long-random-secret

# ─── Check-in config ──────────────────────────────────────────────────────────
# Độ chính xác GPS tối đa cho phép (mét). Mặc định 50m.
CHECKIN_MAX_GPS_ACCURACY_METERS=50

# ─── Trekking Provider ────────────────────────────────────────────────────────
# mock  → đọc từ src/mocks/milestones.json (test/demo)
# http  → gọi HTTP đến trekking-service (development/production)
TREKKING_PROVIDER=http

# Chỉ dùng khi TREKKING_PROVIDER=http
TREKKING_SERVICE_URL=http://localhost:3003
# Với Docker, đặt URL thành http://trekking-service:3003
# TREKKING_HTTP_TIMEOUT_MS=5000

# ─── RabbitMQ (event publishing) ─────────────────────────────────────────────
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=trekvn.events
RABBITMQ_ENABLED=false

# Deliver durable gamification events over internal HTTP when RabbitMQ is unavailable.
GAMIFICATION_HTTP_ENABLED=true
AUTH_SERVICE_URL=http://localhost:3001
# Same secret as auth-service; never expose this token to clients.
TREKVIET_INTERNAL_TOKEN=replace-with-shared-service-token

# Trusted reverse-proxy IPs/CIDRs (empty = ignore forwarded client headers)
TRUSTED_PROXIES=
