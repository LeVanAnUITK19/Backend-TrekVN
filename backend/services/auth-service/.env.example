# App
NODE_ENV=development
PORT=3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/trekviet

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_RESET_SECRET=your_reset_secret_here
JWT_REFRESH_EXPIRES_DAYS=30

# Email (OTP)
# Render Free: use emailjs, brevo or resend (HTTPS); SMTP is blocked on ports 25/465/587.
# For local Gmail SMTP, use EMAIL_PROVIDER=smtp with EMAIL_USER and EMAIL_PASS.
EMAIL_PROVIDER=emailjs
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
# Required only when private-key authorization is enabled in EmailJS Account/Security.
EMAILJS_PRIVATE_KEY=
# Alternatives: change EMAIL_PROVIDER to brevo or resend and configure that provider.
BREVO_API_KEY=your_brevo_api_key
# EMAIL_FROM is used by Brevo/Resend/SMTP. EmailJS uses its connected service sender.
EMAIL_FROM=TrekViet <your_verified_sender@gmail.com>
# Resend alternative: use EMAIL_PROVIDER=resend and a sender on a verified domain.
RESEND_API_KEY=your_resend_api_key
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Bcrypt
BCRYPT_ROUNDS=12

# Logging
LOG_LEVEL=info

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Sign-In (OAuth 2.0)
GOOGLE_CLIENT_ID_WEB=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com

# RabbitMQ (event consumer for gamification)
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=trekvn.events
RABBITMQ_ENABLED=true

# Dashboard aggregation (URLs of the running services)
TREKKING_SERVICE_URL=http://localhost:3003
CHECKIN_SERVICE_URL=http://localhost:3002

# Trusted reverse-proxy IPs/CIDRs (empty = ignore forwarded client headers)
# Actual trusted upstream proxy IPs/CIDRs; required for correct anonymous/login IP quotas.
# Signed users have separate quotas by verified user ID, even behind the same proxy.
TRUSTED_PROXIES=

# Prometheus scrape token (separate from JWT/internal API tokens).
# Empty = public /metrics for local development; set a long random value on Render.
METRICS_TOKEN=
