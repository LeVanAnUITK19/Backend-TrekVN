NODE_ENV=development
PORT=3004
# Transactions require MongoDB Atlas or a replica set, including local development.
MONGODB_URI=mongodb://localhost:27017/community_db?replicaSet=rs0
JWT_SECRET=
AUTH_SERVICE_URL=http://localhost:3001
TREKKING_SERVICE_URL=http://localhost:3003
TREKVIET_INTERNAL_TOKEN=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_PROXIES=loopback
RATE_LIMIT_MAX=600
METRICS_TOKEN=
# Required for realtime fan-out when running more than one community instance.
REDIS_URL=
COMMUNITY_REDIS_CHANNEL=trekvn:community:events
WS_MAX_CONNECTIONS=1000
WS_SESSION_CHECK_MS=60000
