# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# ── Agent MongoDB ─────────────────────────────────────────────────────────────
# Separate database from production trekking DB — NEVER point to production MongoDB
AGENT_MONGODB_URI=mongodb://localhost:27017
AGENT_MONGODB_DB=trekviet_agent

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Must match JWT_SECRET in auth-service
AUTH_SERVICE_URL=http://localhost:3001
JWT_SECRET=

# ── Trekking Service (internal calls after approval) ─────────────────────────
TREKKING_SERVICE_URL=http://localhost:3003
# Service-to-service token — NEVER expose to frontend
TREKVIET_INTERNAL_TOKEN=

# ── Checkin Service ───────────────────────────────────────────────────────────
CHECKIN_SERVICE_URL=http://localhost:3002

# ── LLM Providers ─────────────────────────────────────────────────────────────
LLM_DEFAULT_PROVIDER=auto
LLM_PROVIDER_PRIORITY=uit,groq,openai

# UIT LLM (OpenAI-compatible endpoint — do NOT hard-code university IP)
UIT_LLM_ENABLED=true
UIT_LLM_BASE_URL=
UIT_LLM_API_KEY=
UIT_LLM_MODEL=

# Groq
GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# OpenAI (optional)
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Upload credentials — NEVER expose to Flutter/frontend clients
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for download links (no trailing slash)
R2_PUBLIC_BASE_URL=
# Optional: override endpoint if using custom domain
R2_ENDPOINT_URL=

# ── Map Builder ───────────────────────────────────────────────────────────────
MAP_WORK_ROOT=/tmp/trekviet-agent
MAP_ARTIFACT_TTL_HOURS=72
MAP_DEFAULT_MAX_ZOOM=14
MAP_DEFAULT_MIN_ZOOM=10
# Max bbox area in square degrees (guard against oversized bbox)
MAP_BBOX_MAX_AREA_DEG2=0.5
# Full mode requires map tools locally or in the configured Docker image.
MAP_PIPELINE_MODE=full
# auto: native binaries on Linux; on Windows use Docker/WSL if native tools are absent.
MAP_TOOL_BACKEND=auto
MAP_TOOL_IMAGE=trekvn-agent-map-tools:latest
MAP_WSL_DISTRIBUTION=Ubuntu
MAP_TOOL_CONTAINER_USER=1000:1000
# Optional existing offline ZIP: cut its MBTiles to bbox without native tools.
# Requests outside this source's coverage fail instead of returning an unrelated map.
MAP_SOURCE_PACKAGE=
# Prefer a downloaded regional OSM PBF over Overpass (different from MBTiles ZIP).
# Download with scripts/download_osm_source.py; mount this file when using Docker.
MAP_OSM_PBF_PATH=
# Optional local GeoTIFF/HGT. Empty = fetch public Skadi elevation tiles.
MAP_DEM_PATH=
MAP_DEM_URL_TEMPLATE=https://s3.amazonaws.com/elevation-tiles-prod/skadi/{lat}/{tile}.hgt.gz
MAP_CONTOUR_INTERVAL_M=20
MAP_NATIVE_MAX_ZOOM=14
MAP_HILLSHADE_MAX_ZOOM=12

# ── External Services ─────────────────────────────────────────────────────────
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
REQUEST_TIMEOUT_SECONDS=30

# ── Assistant ─────────────────────────────────────────────────────────────────
ASSISTANT_MAX_CONTEXT_MESSAGES=20
ASSISTANT_MAX_OUTPUT_TOKENS=2048

# ── Knowledge Base ─────────────────────────────────────────────────────────────
# Root directory for agent knowledge documents (mounted into container)
AGENT_KNOWLEDGE_ROOT=/app/knowledge
# Max chars per knowledge chunk returned to LLM
KNOWLEDGE_MAX_CHUNK_CHARS=1200
# Top-K chunks returned per search query
KNOWLEDGE_SEARCH_TOP_K=5

# Prometheus scrape token (separate from JWT/internal API tokens).
# Empty = public /metrics for local development; set a long random value on Render.
METRICS_TOKEN=
