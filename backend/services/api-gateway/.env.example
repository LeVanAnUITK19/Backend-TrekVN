PORT=3000
AUTH_SERVICE_URL=http://localhost:3001
CHECKIN_SERVICE_URL=http://localhost:3002
TREKKING_SERVICE_URL=http://localhost:3003
COMMUNITY_SERVICE_URL=http://localhost:3004
AGENT_SERVICE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8080

# Rate limiting (SRS NFR-SYNC-01 / BR-22)
# windowMs in ms; max = requests per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600

# Comma-separated IPs/CIDRs of the reverse proxies directly in front of gateway.
# Empty does not trust forwarded headers. Set the actual proxy IP/subnet when deployed behind a proxy.
TRUSTED_PROXIES=

# Prometheus scrape token (separate from JWT/internal API tokens).
# Empty = public /metrics for local development; set a long random value on Render.
METRICS_TOKEN=
