{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "TrekVN API Gateway - routes and proxies requests to backend microservices",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --runInBand --watch",
    "lint": "eslint src/**/*.js",
    "test:ci": "jest --runInBand --forceExit --coverage"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.4",
    "http-proxy": "^1.18.1",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^13.1.0",
    "eslint": "^8.57.1",
    "jest": "^30.5.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000
  }
}
