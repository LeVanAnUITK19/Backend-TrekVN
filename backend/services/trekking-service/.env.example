NODE_ENV=development
PORT=3003

MONGODB_URI=mongodb://localhost:27017/trekviet

JWT_SECRET=your_jwt_secret_here

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=trekvn.events
RABBITMQ_ENABLED=false

LOG_LEVEL=info

CHECKIN_SERVICE_URL=http://checkin-service:3002
CHECKIN_HTTP_TIMEOUT_MS=5000

# Cloudflare R2 — public base URL (NO trailing slash)
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# Outbox worker
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_RETRY=10

# Public bucket used by agent map artifacts; defaults to R2_PUBLIC_BASE_URL.
MAP_R2_PUBLIC_BASE_URL=

# Deliver durable gamification events over internal HTTP when RabbitMQ is unavailable.
GAMIFICATION_HTTP_ENABLED=true
AUTH_SERVICE_URL=http://localhost:3001
# Same secret as auth-service; never expose this token to clients.
TREKVIET_INTERNAL_TOKEN=replace-with-shared-service-token

# Trusted reverse-proxy IPs/CIDRs (empty = ignore forwarded client headers)
TRUSTED_PROXIES=

# Requests per client IP per window; health/ready probes are excluded.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600

# Upstash TCP with TLS. Credentials belong only in the ignored .env / host secrets.
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379
CATALOG_CACHE_TTL_SECONDS=30
CATALOG_CACHE_PREFIX=trekvn:catalog:v2
