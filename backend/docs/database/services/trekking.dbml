// ======================================================
// TREKVIET - TREKKING SERVICE
// ======================================================
//
// Main trekking domain:
// - Places
// - Routes
// - Official milestones
// - Journeys
// - User-created journey markers
// - Route/place contributions
// - Badges
//
// Cross-service references nằm trong ../server.dbml
//
// ======================================================


// ======================================================
// TREKKING PLACES
// ======================================================

Table trekking_places {
  trekkingPlaceId varchar [pk]

  name varchar [not null]
  slug varchar [unique]

  provinceId varchar [not null]

  address varchar

  // GeoJSON Point:
  // { "type": "Point", "coordinates": [longitude, latitude] }
  location json [not null]

  description text

  difficulty varchar

  // Đơn vị: phút
  averageDurationMinutes int

  // Optional: độ cao đại diện của địa điểm / đỉnh núi (mét)
  elevationMeters int

  // Danh sách URL ảnh
  images json

  // Ảnh preview/minimap của địa điểm.
  // Không phải file offline map package.
  imageMapUrl varchar

  // Ví dụ:
  // ["mountain", "camping", "cloud-hunting"]
  tags json

  // Nguồn tạo bản ghi:
  // MANUAL | USER_CONTRIBUTION | AI_AGENT
  dataOrigin varchar [default: 'MANUAL']

  // External IDs phục vụ chống trùng và cập nhật lại dữ liệu.
  // Ví dụ:
  // {
  //   "osm": { "type": "node", "id": "123456" },
  //   "wikidataId": "Q123456"
  // }
  externalRefs json

  // Thời điểm gần nhất dữ liệu được Admin/Agent xác minh lại.
  lastVerifiedAt timestamp

  // Offline map cấp ĐỊA ĐIỂM.
  // Chỉ lưu R2 objectKey; downloadUrl được backend build runtime.
  //
  // Ví dụ:
  // {
  //   "available": true,
  //   "version": 1,
  //   "objectKey": "maps/nui-ba-den/v1/ba-den-v1-flutter.zip",
  //   "sizeBytes": 19300000,
  //   "checksum": "sha256...",
  //   "minZoom": 10,
  //   "maxZoom": 14,
  //   "bounds": {
  //     "minLon": 106.139430, "minLat": 11.361570,
  //     "maxLon": 106.191620, "maxLat": 11.412390
  //   }
  // }
  offlineMap json

  ratingAverage double [default: 0]
  ratingCount int [default: 0]

  status varchar [default: 'ACTIVE']

  createdAt timestamp
  updatedAt timestamp

  indexes {
    provinceId
    status
    (provinceId, status)
    dataOrigin
    // MongoDB/Mongoose: location cần 2dsphere index
    // MongoDB/Mongoose: sparse index cho externalRefs.osm.id / wikidataId nếu dùng duplicate lookup
  }
}


// ======================================================
// PLACE REVIEWS
// ======================================================

Table detail_evaluates {
  detailEvaluateId varchar [pk]

  trekkingPlaceId varchar [not null]
  userId varchar [not null]

  // 1 -> 5
  point int [not null]

  content text

  imagesUrl json
  videoUrl json

  deleted boolean [default: false]

  createdAt timestamp
  updatedAt timestamp

  indexes {
    (trekkingPlaceId, userId)
  }
}


// ======================================================
// TREKKING ROUTES
// ======================================================

Table trekking_routes {
  trekkingRouteId varchar [pk]

  trekkingPlaceId varchar [not null]

  name varchar [not null]
  description text

  difficulty varchar

  // mét
  distanceMeters int

  // phút
  estimatedDurationMinutes int

  // mét
  elevationGain int
  maxElevation int

  // GeoJSON Point
  startLocation json

  // GeoJSON Point
  endLocation json

  // GeoJSON LineString
  path json

  // R2 objectKey thay vì full URL — backend build downloadUrl tại runtime.
  //
  // Ví dụ:
  // {
  //   "available": true,
  //   "version": 1,
  //   "objectKey": "ba-den/v1/ba-den-v1-flutter.zip",
  //   "sizeBytes": 0,
  //   "checksum": "",
  //   "minZoom": 8,
  //   "maxZoom": 14,
  //   "bounds": {
  //     "minLon": 106.139430, "minLat": 11.361570,
  //     "maxLon": 106.191620, "maxLat": 11.412390
  //   }
  // }
  //
  // downloadUrl KHÔNG lưu trong DB.
  // Backend: downloadUrl = R2_PUBLIC_BASE_URL + "/" + objectKey
  offlineMap json

  status varchar [default: 'ACTIVE']

  createdAt timestamp
  updatedAt timestamp

  indexes {
    trekkingPlaceId
    status
    (trekkingPlaceId, status)
  }
}


// ======================================================
// OFFICIAL MILESTONES
// ======================================================

Table milestones {
  milestoneId varchar [pk]

  trekkingRouteId varchar [not null]

  name varchar [not null]
  description text

  // START
  // CHECKPOINT
  // VIEWPOINT
  // REST_POINT
  // WATER_POINT
  // CAMP
  // SUMMIT
  // FINISH
  type varchar [not null]

  sequence int [not null]

  // GeoJSON Point
  location json [not null]

  altitude int

  // mét
  checkinRadiusMeters int [default: 50]

  required boolean [default: true]

  imageUrl varchar

  createdAt timestamp
  updatedAt timestamp

  indexes {
    (trekkingRouteId, sequence) [unique]
  }
}


// ======================================================
// JOURNEYS
// ======================================================

Table journeys {
  journeyId varchar [pk]

  userId varchar [not null]

  // ID do mobile sinh ra trước khi sync.
  // Dùng làm idempotency key khi create/retry journey offline-first.
  clientJourneyId varchar

  trekkingPlaceId varchar [not null]
  trekkingRouteId varchar [not null]

  provinceId varchar

  name varchar [not null]

  // PLANNED
  // ACTIVE
  // PAUSED
  // COMPLETED
  // CANCELLED
  status varchar [default: 'PLANNED']

  plannedStartAt timestamp

  startedAt timestamp
  completedAt timestamp

  // {
  //   "distanceMeters": 12840,
  //   "durationSeconds": 18400,
  //   "elevationGain": 870,
  //   "maxAltitude": 2167,
  //   "averageSpeed": 2.5
  // }
  statistics json

  // Không lưu hàng nghìn GPS points trên server.
  //
  // Sau khi hoàn thành:
  // {
  //   "encodedPolyline": "..."
  // }
  track json

  checkinCount int [default: 0]
  markerCount int [default: 0]

  createdAt timestamp
  updatedAt timestamp

  indexes {
    userId
    trekkingPlaceId
    trekkingRouteId
    provinceId
    status
    createdAt
    (userId, status)
    (userId, createdAt)
    // MongoDB/Mongoose: unique partial/sparse index trên clientJourneyId
  }
}


// ======================================================
// USER-CREATED JOURNEY MARKERS
// ======================================================

Table journey_markers {
  journeyMarkerId varchar [pk]

  journeyId varchar [not null]

  userId varchar [not null]

  name varchar [not null]

  type varchar [not null]

  note text

  // GeoJSON Point
  location json [not null]

  altitude double

  accuracyMeters double

  // URL ảnh đã upload
  images json

  markedAt timestamp [not null]

  // USER_CREATED
  source varchar [default: 'USER_CREATED']

  // Client generated ID dùng cho idempotency
  clientMarkerId varchar

  createdAt timestamp
  updatedAt timestamp

  indexes {
    journeyId
    userId
    (journeyId, markedAt)
    clientMarkerId
    // MongoDB/Mongoose: unique partial index cho (userId, clientMarkerId)
  }
}


// ======================================================
// ROUTE SUBMISSIONS
// ======================================================

Table route_submissions {
  routeSubmissionId varchar [pk]

  userId varchar [not null]

  sourceJourneyId varchar [not null]

  trekkingPlaceId varchar

  proposedName varchar

  description text
  notes text

  encodedPolyline text
  gpxUrl varchar

  statistics json

  images json

  // DRAFT
  // PENDING_REVIEW
  // NEEDS_REVISION
  // APPROVED
  // REJECTED
  // CANCELLED
  status varchar [not null, default: 'PENDING_REVIEW']

  reviewedBy varchar
  reviewedAt timestamp

  adminNote text

  resultingRouteId varchar

  clientOperationId varchar [unique]

  createdAt timestamp
  updatedAt timestamp

  indexes {
    userId
    sourceJourneyId
    status
    createdAt
  }
}


// ======================================================
// ROUTE SUBMISSION MARKERS
// ======================================================

Table route_submission_markers {
  routeSubmissionMarkerId varchar [pk]

  routeSubmissionId varchar [not null]

  // Marker ban đầu của journey
  sourceJourneyMarkerId varchar

  name varchar [not null]

  type varchar [not null]

  description text

  // GeoJSON Point
  location json [not null]

  altitude double

  images json

  // Thứ tự dọc route
  sequence int

  // PENDING
  // APPROVED
  // REJECTED
  reviewStatus varchar [default: 'PENDING']

  adminNote text

  // Nếu admin convert thành official milestone
  resultingMilestoneId varchar

  createdAt timestamp
  updatedAt timestamp

  indexes {
    routeSubmissionId
    reviewStatus
    sequence
  }
}


// ======================================================
// PLACE SUGGESTIONS
// ======================================================

Table place_suggestions {
  placeSuggestionId varchar [pk]

  userId varchar [not null]

  provinceId varchar [not null]

  proposedName varchar [not null]

  address varchar

  location json [not null]

  description text [not null]

  difficulty varchar

  tags json
  images json

  // DRAFT
  // PENDING_REVIEW
  // NEEDS_REVISION
  // APPROVED
  // REJECTED
  // CANCELLED
  status varchar [not null, default: 'PENDING_REVIEW']

  reviewedBy varchar
  reviewedAt timestamp

  adminNote text

  resultingPlaceId varchar

  clientOperationId varchar [unique]

  createdAt timestamp
  updatedAt timestamp

  indexes {
    userId
    provinceId
    status
    createdAt
  }
}


// ======================================================
// BADGES
// ======================================================

Table badges {
  badgeId varchar [pk]

  code varchar [not null, unique]

  name varchar [not null]
  description text

  iconUrl varchar

  // TREKKING
  // EXPLORATION
  // DISTANCE
  // PROVINCE
  category varchar

  // COMMON
  // RARE
  // EPIC
  // LEGENDARY
  rarity varchar

  // {
  //   "type": "ALTITUDE_REACHED",
  //   "value": 2000
  // }
  condition json

  status varchar [default: 'ACTIVE']

  createdAt timestamp
  updatedAt timestamp

  indexes {
    category
    rarity
    status
  }
}


// ======================================================
// USER BADGES
// ======================================================

Table user_badges {
  userBadgeId varchar [pk]

  userId varchar [not null]

  badgeId varchar [not null]

  // Journey giúp user đạt badge
  journeyId varchar

  earnedAt timestamp [not null]

  createdAt timestamp
  updatedAt timestamp

  indexes {
    (userId, badgeId) [unique]
    badgeId
    earnedAt
    (userId, earnedAt)
  }
}


// ======================================================
// INTERNAL RELATIONSHIPS
// ======================================================

Ref: trekking_routes.trekkingPlaceId > trekking_places.trekkingPlaceId

Ref: detail_evaluates.trekkingPlaceId > trekking_places.trekkingPlaceId

Ref: milestones.trekkingRouteId > trekking_routes.trekkingRouteId

Ref: journeys.trekkingPlaceId > trekking_places.trekkingPlaceId

Ref: journeys.trekkingRouteId > trekking_routes.trekkingRouteId

Ref: journey_markers.journeyId > journeys.journeyId

Ref: route_submission_markers.routeSubmissionId >
     route_submissions.routeSubmissionId

Ref: route_submission_markers.sourceJourneyMarkerId >
     journey_markers.journeyMarkerId

Ref: route_submission_markers.resultingMilestoneId >
     milestones.milestoneId

Ref: route_submissions.sourceJourneyId > journeys.journeyId

Ref: route_submissions.trekkingPlaceId > trekking_places.trekkingPlaceId

Ref: route_submissions.resultingRouteId > trekking_routes.trekkingRouteId

Ref: place_suggestions.resultingPlaceId > trekking_places.trekkingPlaceId

Ref: user_badges.badgeId > badges.badgeId

Ref: user_badges.journeyId > journeys.journeyId


// ======================================================
// VISUAL GROUP
// ======================================================

TableGroup trekking_service {
  trekking_places
  detail_evaluates
  trekking_routes
  milestones
  journeys
  journey_markers
  route_submissions
  route_submission_markers
  place_suggestions
  badges
  user_badges
}


// ======================================================
// VERSION 3.1 IMPLEMENTATION ALIGNMENT (v4.0 code changes)
// ======================================================
//
// Infrastructure/operational tables added for reliable event delivery
// and consumer idempotency.
// ======================================================

// ── Transactional Outbox ────────────────────────────────

Table event_outbox {
  // MongoDB/Mongoose collection: eventoutboxes

  eventId varchar [pk, unique]
  eventType varchar [not null]
  eventVersion int [default: 1]
  payload json [not null]

  // PENDING | PROCESSING | PUBLISHED | FAILED
  status varchar [not null, default: 'PENDING']

  retryCount int [default: 0]
  nextRetryAt timestamp
  lastError varchar
  publishedAt timestamp

  createdAt timestamp
  updatedAt timestamp

  indexes {
    (status, nextRetryAt)
    publishedAt  // TTL index (PUBLISHED only) — auto-delete after 7 days
  }
}

// ── Consumer idempotency ────────────────────────────────

Table trekking_processed_events {
  // MongoDB/Mongoose collection: processedevents (trekking_db)
  // Same schema as auth_db.processed_events

  eventId varchar [not null]
  consumerName varchar [not null]
  // e.g. "trekking.checkinCount" | "trekking.badge"
  processedAt timestamp [not null]

  indexes {
    (eventId, consumerName) [unique]
    processedAt  // TTL index — auto-delete after 30 days
  }
}
