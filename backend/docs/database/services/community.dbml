// ======================================================
// TREKVIET - COMMUNITY SERVICE
// ======================================================
//
// Cross-service references nằm trong ../server.dbml
//
// ======================================================


// ======================================================
// POSTS
// ======================================================

Table posts {
  postId varchar [pk]

  authorId varchar [not null]

  content text

  // Danh sách URL ảnh.
  // Giới hạn <= 5 tại application layer.
  images json

  // NORMAL
  // JOURNEY_SHARE
  // BADGE_SHARE
  type varchar [default: 'NORMAL']

  journeyId varchar

  trekkingPlaceId varchar

  reactionCount int [default: 0]

  commentCount int [default: 0]

  // PUBLIC | PRIVATE
  visibility varchar [default: 'PUBLIC']

  // Soft deletion and write fence for transactional child mutations.
  deleted boolean [default: false]
  hidden boolean [default: false]
  moderationReason text
  moderatedBy varchar
  moderatedAt timestamp
  revision int [default: 0]

  createdAt timestamp
  updatedAt timestamp

  indexes {
    authorId
    journeyId
    trekkingPlaceId
  }
}


// ======================================================
// COMMENTS
// ======================================================

Table comments {
  commentId varchar [pk]

  postId varchar [not null]

  authorId varchar [not null]

  // Null = comment gốc.
  // Có giá trị = reply comment.
  parentCommentId varchar

  // Denormalized root for rendering replies at any depth.
  rootCommentId varchar

  content text [not null]

  deleted boolean [default: false]
  hidden boolean [default: false]
  moderationReason text
  moderatedBy varchar
  moderatedAt timestamp
  likeCount int [default: 0]

  createdAt timestamp
  updatedAt timestamp

  indexes {
    postId
    authorId
  }
}


// ======================================================
// REACTIONS
// ======================================================

Table reactions {
  reactionId varchar [pk]

  postId varchar [not null]

  userId varchar [not null]

  // LIKE
  type varchar [default: 'LIKE']

  createdAt timestamp
  updatedAt timestamp

  indexes {
    (postId, userId) [unique]
  }
}


// ======================================================
// INTERNAL RELATIONSHIPS
// ======================================================

Ref: comments.postId > posts.postId

Ref: reactions.postId > posts.postId

Ref: comments.parentCommentId > comments.commentId
Ref: comments.rootCommentId > comments.commentId

// Separate collection preserves the original post reaction contract.
Table comment_reactions {
  commentReactionId varchar [pk]
  commentId varchar [not null]
  postId varchar [not null]
  userId varchar [not null]
  createdAt timestamp
  updatedAt timestamp
  indexes {
    (commentId, userId) [unique]
    postId
  }
}
Ref: comment_reactions.commentId > comments.commentId
Ref: comment_reactions.postId > posts.postId


// ======================================================
// VISUAL GROUP
// ======================================================

Table moderation_logs {
  logId varchar [pk]
  adminId varchar [not null]
  entityType varchar [not null, note: 'POST | COMMENT']
  entityId varchar [not null]
  postId varchar [not null]
  action varchar [not null, note: 'HIDE | PUBLISH | DELETE']
  reason text [not null]
  beforeStatus varchar [not null]
  afterStatus varchar [not null]
  createdAt timestamp
  indexes {
    (postId, createdAt)
    (entityType, entityId, createdAt)
  }
}
Ref: moderation_logs.postId > posts.postId

TableGroup community_service {
  posts
  comments
  reactions
  comment_reactions
  moderation_logs
  community_profiles
  conversations
  conversation_members
  messages
  message_reports
  social_moderation_logs
}

Table community_profiles {
  profileId varchar [pk]
  userId varchar [not null, unique]
  bio text [note: 'Giới thiệu Community; tên/avatar thuộc auth-service']
  qrToken varchar [not null, unique, note: '48 hex ngẫu nhiên; có thể cấp lại; không phải access token']
  createdAt timestamp
  updatedAt timestamp
}
Table conversations {
  conversationId varchar [pk]
  kind varchar [not null, note: 'DIRECT | GROUP']
  directKey varchar [note: 'Cặp userId đã sort; partial unique index chỉ với DIRECT']
  name varchar
  ownerId varchar [not null]
  memberIds json [not null, note: 'Tối đa 50; nguồn kiểm tra quyền hiện tại']
  sequence int [default: 0, note: 'Counter và write fence transaction']
  lastMessageAt timestamp
  disabled boolean [default: false]
  moderationReason text
  createdAt timestamp
  updatedAt timestamp
}
Table conversation_members {
  membershipId varchar [pk]
  conversationId varchar [not null]
  userId varchar [not null]
  joinedSequence int [not null, note: 'Không được đọc tin trước lần tham gia hiện tại']
  readSequence int [default: 0]
  createdAt timestamp
  updatedAt timestamp
  indexes { (conversationId, userId) [unique] }
}
Table messages {
  messageId varchar [pk]
  conversationId varchar [not null]
  senderId varchar [not null]
  clientMessageId varchar [not null, note: 'Mã retry do client tạo']
  sequence int [not null]
  content text
  deleted boolean [default: false]
  createdAt timestamp
  updatedAt timestamp
  indexes {
    (conversationId, sequence) [unique]
    (conversationId, senderId, clientMessageId) [unique]
  }
}
Table message_reports {
  reportId varchar [pk]
  reporterId varchar [not null]
  messageId varchar [not null]
  conversationId varchar [not null]
  senderId varchar [not null]
  contentSnapshot text [not null, note: 'Chỉ tin được báo cáo, không lưu ngữ cảnh chat khác']
  reason text [not null]
  status varchar [default: 'OPEN', note: 'OPEN | RESOLVED | DISMISSED']
  resolution text
  resolvedBy varchar
  resolvedAt timestamp
  createdAt timestamp
  updatedAt timestamp
  indexes { (reporterId, messageId) [unique] }
}
Table social_moderation_logs {
  logId varchar [pk]
  adminId varchar [not null]
  entityId varchar [not null]
  action varchar [not null]
  reason text [not null]
  createdAt timestamp
}
Ref: conversation_members.conversationId > conversations.conversationId
Ref: messages.conversationId > conversations.conversationId
Ref: message_reports.conversationId > conversations.conversationId
Ref: message_reports.messageId > messages.messageId
